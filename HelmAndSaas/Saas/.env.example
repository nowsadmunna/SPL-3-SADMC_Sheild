# ─── SERVER ─────────────────────────────────────────────────────
PORT=8000

# ─── DATABASE (docker-compose timescaledb service) ──────────────
DATABASE_URL=postgres://sadmc:sadmc_dev_password@localhost:5433/sadmc_shield

# ─── REDIS (docker-compose redis service) ───────────────────────
REDIS_URL=redis://localhost:6380

# ─── AUTH ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_COST=12

# ─── API KEYS ────────────────────────────────────────────────────
API_KEY_CACHE_TTL_SECONDS=300

# ─── INFERENCE ───────────────────────────────────────────────────
# stub = always returns NORMAL (use while building/testing the rest of the pipeline)
# onnx = runs the real exported SADMC model
INFERENCE_MODE=stub
# ONNX_MODEL_PATH=./inference/model/v3/sadmc_model.onnx   (default; override only for experiments)

# ─── NOTE ────────────────────────────────────────────────────────
# The in-cluster Agent's own env vars (SADMC_API_KEY, SAAS_ENDPOINT,
# CLUSTER_NAME, etc.) are configured separately via the Helm chart
# at HelmAndSaas/Helm/charts/sadmc-agent/values.yaml — not here.

# Feature vector the backend applies by default (agents send their own `feature_set`; v3 = 33 features). Only v3 exists at the moment.
# FEATURE_SET=v3
